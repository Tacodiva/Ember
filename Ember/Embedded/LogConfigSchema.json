{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "definitions": {
        "logLevel": {
            "type": "number",
            "minimum": 0,
            "maximum": 6
        },
        "loggerMap": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/definitions/logLevel"
            },
            "propertyNames": {
                "oneOf": [
                    {
                        "pattern": "^[a-zA-Z0-9_]+(?:\\/[a-zA-Z0-9_]+)*$"
                    }
                ]
            }
        }
    },
    "properties": {
        "Global": {
            "Default": {
                "$ref": "#/definitions/logLevel"
            },
            "Loggers": {
                "$ref": "#/definitions/loggerMap"
            }
        }
    },
    "additionalProperties": {
        "type": "object",
        "properties": {
            "Enabled": {
                "type": "boolean",
                "default": true
            },
            "Default": {
                "$ref": "#/definitions/logLevel"
            },
            "Loggers": {
                "$ref": "#/definitions/loggerMap"
            },
            "Settings": {
                "type": "object"
            }
        },
        "additionalProperties": false
    }
}